# Copy this file to ".env" and fill in your own values. Never commit the real .env file.

# Google Gemini API key (used by ai_service.py to generate client summaries)
GEMINI_API_KEY=your_gemini_api_key_here

# Speechmatics API key (used by tts_service.py for the "Listen to Summary" audio)
SPEECHMATICS_API_KEY=your_speechmatics_api_key_here

# Google Sheet ID (the long ID in your sheet's URL, between /d/ and /edit)
SHEET_ID=your_google_sheet_id_here

# Path to your Google service account JSON key file (must have edit access to the sheet)
KEY_FILE=key.json
